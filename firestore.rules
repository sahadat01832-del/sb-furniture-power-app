rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public clients may read only the current phone API origin. Writes are
    // reserved for the phone's trusted Firebase Admin SDK.
    match /system_config/backend_tunnel {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // Backup data is written only by the trusted Node.js server using Admin SDK.
    // Browser and mobile clients must never read customer database snapshots.
    match /sb_power_app_backups/{backupId} {
      allow read, write: if false;

      match /backup_chunks/{chunkId} {
        allow read, write: if false;
      }
    }

    // Product photo backups are uploaded by the phone's server and restored
    // only with Admin SDK credentials; clients must never read them.
    match /sb_power_upload_backups/{fileId} {
      allow read, write: if false;

      match /upload_chunks/{chunkId} {
        allow read, write: if false;
      }
    }
  }
}
