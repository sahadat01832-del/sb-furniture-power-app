# SB Furniture App Configuration
PORT=3000
# 127.0.0.1 keeps the API private behind a tunnel/reverse proxy. Use 0.0.0.0 only on a server that needs direct access.
HOST=127.0.0.1
NODE_ENV=development
JWT_SECRET=
ADMIN_PHONE=
ADMIN_PASSWORD=
# Add your exact Firebase Hosting origins in production; localhost is for development.
CORS_ORIGIN=
CORS_ORIGINS=http://localhost:3000,https://localhost,capacitor://localhost
DATABASE_FILE=data/database.sqlite
# Local snapshot schedule. 360 minutes = 6 hours; lower it to 60 for hourly backups.
BACKUP_INTERVAL_MINUTES=360
# One AI model call / the whole failover chain (milliseconds).
OMNIROUTE_TIMEOUT_MS=15000
OMNIROUTE_TOTAL_BUDGET_MS=30000
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_BACKUP_ENCRYPTION_KEY_FILE=
FIREBASE_BACKUP_RETENTION=7
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
